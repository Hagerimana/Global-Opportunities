msgstr "Cette invitation n'attend plus de réponse."

msgid "This invitation's access has been revoked."
msgstr "L'accès à cette invitation a été révoqué."

msgid "This personal account has no linked person profile. Please contact support."
msgstr "Ce compte personnel n'a pas de profil de personne lié. Veuillez contacter le support."

msgid "This project cannot accept guidance now."
msgstr "Ce projet ne peut pas accepter de conseils pour le moment."

msgid "This project has no uploaded proposal. A proposal must be uploaded and prepared before posting."
msgstr "Ce projet n'a pas de proposition téléversée. Une proposition doit être téléversée et préparée avant la publication."

msgid "This project is not accepting messages."
msgstr "Ce projet n'accepte pas de messages."

msgid "This project page is temporarily unavailable."
msgstr "Cette page de projet est temporairement indisponible."

msgid "This proposal is not marked as the current prepared version."
msgstr "Cette proposition n'est pas marquée comme la version préparée actuelle."

msgid "This refresh token does not belong to your account."
msgstr "Ce jeton de rafraîchissement n'appartient pas à votre compte."

msgid "This registration does not exist or has already been verified."
msgstr "Cette inscription n'existe pas ou a déjà été vérifiée."

msgid "This registration has an invalid account type."
msgstr "Cette inscription a un type de compte invalide."

msgid "This requirement belongs to a different professional profile type."
msgstr "Cette exigence appartient à un autre type de profil professionnel."

msgid "This send identifier was already used for a different message."
msgstr "Cet identifiant d'envoi a déjà été utilisé pour un autre message."

msgid "This verification code has expired. Request a new code."
msgstr "Ce code de vérification a expiré. Demandez un nouveau code."

msgid "Too many incorrect attempts. Request a new code."
msgstr "Trop de tentatives incorrectes. Demandez un nouveau code."

msgid "Total budget must equal requested funding plus own contribution."
msgstr "Le budget total doit être égal au financement demandé plus la contribution propre."

msgid "Trainer"
msgstr "Formateur"

msgid "Unable to log in with those credentials."
msgstr "Impossible de se connecter avec ces identifiants."

msgid "Unsupported notification target."
msgstr "Cible de notification non prise en charge."

msgid "Unsupported notification type."
msgstr "Type de notification non pris en charge."

msgid "Use an opportunity or call detail page to inspect official information."
msgstr "Utilisez une page de détail d'opportunité ou d'appel pour consulter les informations officielles."

msgid "Use no more than {} characters."
msgstr "N'utilisez pas plus de {} caractères."

msgid "Use only letters, spaces, apostrophes, or hyphens in the {}."
msgstr "Utilisez uniquement des lettres, des espaces, des apostrophes ou des traits d'union dans le {}."

msgid "Use uppercase, lowercase, number, and symbol characters."
msgstr "Utilisez des majuscules, des minuscules, des chiffres et des symboles."

msgid "Verify your Global Opportunities account"
msgstr "Vérifiez votre compte Global Opportunities"

msgid "Verify your login email before requesting a professional profile."
msgstr "Vérifiez votre e-mail de connexion avant de demander un profil professionnel."

msgid "We could not send the recovery email right now. Please try again later."
msgstr "Nous n'avons pas pu envoyer l'e-mail de récupération pour le moment. Veuillez réessayer plus tard."

msgid "We could not send the verification email right now. Please try again later."
msgstr "Nous n'avons pas pu envoyer l'e-mail de vérification pour le moment. Veuillez réessayer plus tard."

msgid "We could not send the verification email right now. Please try registering again later."
msgstr "Nous n'avons pas pu envoyer l'e-mail de vérification pour le moment. Veuillez réessayer de vous inscrire plus tard."

msgid "You are not a participant in this conversation."
msgstr "Vous ne participez pas à cette conversation."

msgid "You cannot invite yourself."
msgstr "Vous ne pouvez pas vous inviter vous-même."

msgid "You have a new private project message"
msgstr "Vous avez un nouveau message privé de projet"

msgid "You have received a project Expert invitation"
msgstr "Vous avez reçu une invitation d'expert pour un projet"

msgid "You must be at least 16 years old."
msgstr "Vous devez avoir au moins 16 ans."

msgid "Your Expert invitation expired"
msgstr "Votre invitation d'expert a expiré"

msgid "Your Expert invitation was accepted"
msgstr "Votre invitation d'expert a été acceptée"

msgid "Your Expert invitation was declined"
msgstr "Votre invitation d'expert a été refusée"

msgid "Your account must be active before requesting a professional profile."
msgstr "Votre compte doit être actif avant de demander un profil professionnel."

msgid "Your active profile changed after this draft was created. Create a new update or switch request."
msgstr "Votre profil actif a changé après la création de ce brouillon. Créez une nouvelle demande de mise à jour ou de changement."

msgid "Your password has been reset successfully. You can now log in with your new password."
msgstr "Votre mot de passe a été réinitialisé avec succès. Vous pouvez maintenant vous connecter avec votre nouveau mot de passe."

msgid "Your project was not posted.\n\n{reasons}\n\nYour saved project information remains available. Proposal preparation must complete successfully before posting."
msgstr "Votre projet n'a pas été publié.\n\n{reasons}\n\nLes informations enregistrées de votre projet restent disponibles. La préparation de la proposition doit réussir avant la publication."

msgid "description and funding"
msgstr "description et financement"

msgid "first name"
msgstr "prénom"

msgid "last name"
msgstr "nom de famille"

msgid "personal information"
msgstr "informations personnelles"

msgid "project domain"
msgstr "domaine du projet"

msgid "review and post"
msgstr "vérification et publication"
